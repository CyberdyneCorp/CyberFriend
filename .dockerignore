# Host build output and dependencies must never reach the image.
#
# node_modules is the one that bites: npm installs platform-specific binaries
# (esbuild, rollup), so copying a macOS tree over the container's Linux one
# makes the console build fail inside Docker while succeeding on the machine
# that wrote it -- which is the worst kind of difference to debug.
console/node_modules
console/dist
# The Svelte rewrite is built and tested in CI and never copied into the image.
console-svelte
node_modules

# Python build and test artefacts: large, machine-local, and never run in the
# image.
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage

# Local state and history. .git in particular is tens of megabytes of build
# context that the image never reads.
.git
.github
.claude
*.env
.env
.env.*
!.env.example
