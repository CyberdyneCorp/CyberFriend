# --- Discord -----------------------------------------------------------
# Bot token from the Discord Developer Portal. The MESSAGE_CONTENT
# privileged intent must be enabled for this application.
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Channels to index, space- or comma-separated. Indexing is opt-in:
# leaving this empty indexes nothing.
INDEXED_CHANNEL_IDS=

# --- Storage -----------------------------------------------------------
# Must be a Postgres with the pgvector extension available.
# Coolify: use the "PostgreSQL with pgvector" database type, not plain postgres.
DATABASE_URL=postgresql+asyncpg://chatmemory:chatmemory@localhost:5432/chatmemory

# --- Embeddings --------------------------------------------------------
# Any OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Reasoning ---------------------------------------------------------
# The answering model: it judges evidence, plans and writes, so it must
# honour a response schema. Checked at boot against the stages the bot
# enables; a model that cannot is a startup failure naming what is missing.
CHAT_MODEL=gpt-4o
# The cheap handle on the same provider, for extraction and per-candidate
# scoring -- work that runs over traffic rather than over questions.
EXTRACTION_MODEL=gpt-4o-mini
# What the endpoint behind LLM_BASE_URL actually does, space- or
# comma-separated: chat, structured_output, tool_calling. Leave empty for
# OpenAI's own models. A self-hosted or proxied model must declare its own,
# because an unrecognised name is assumed to do chat and nothing else.
CHAT_MODEL_CAPABILITIES=

# --- Time --------------------------------------------------------------
# The zone whose calendar "ontem" and "semana passada" are read in.
ANSWER_TIMEZONE=America/Sao_Paulo

# --- Windowing ---------------------------------------------------------
WINDOW_MAX_MESSAGES=10
WINDOW_MAX_TOKENS=512
WINDOW_GAP_SECONDS=900

# --- Serving -----------------------------------------------------------
HEALTH_PORT=8080
MCP_PORT=8081
