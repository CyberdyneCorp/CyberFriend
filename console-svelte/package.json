{
  "name": "cyberfriend-console-svelte",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Svelte rewrite of the operator console. Built and tested in CI; replaces console/ in one swap.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  }
}
